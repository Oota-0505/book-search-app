# 設定の見本。コピーして .env を作る（.env はコミットされない）
#
#   cp .env.example .env
#
# ログイン用のパスワード。空にすると認証なしで動く（手元での開発用）
BOOKFINDER_PASSWORD=

# Cookie の署名鍵。空なら data/session_secret.txt に自動生成される。
# 本番では固定値を入れること（変わると全端末のログインが切れる）
BOOKFINDER_SECRET=

# Apps Script から /api/notify を呼ぶときの合言葉。
# 空なら data/notify_token.txt に自動生成される
BOOKFINDER_NOTIFY_TOKEN=

# http://127.0.0.1 で試すときだけ 0 にする（Cookie の Secure 属性を外す）
BOOKFINDER_SECURE_COOKIE=1

# ── Gmail 監視（tools/watch_gmail.py）────────────────────────
# 図書館からの「予約本が用意できました」メールを拾うために使う。
# Gmail は IMAP にアプリパスワードが必要（2段階認証を有効にしてから発行）
#   https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 図書館メールに付けている Gmail のラベル名（任意・指定すると速い）
GMAIL_LABEL=
