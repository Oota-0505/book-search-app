{
  "name": "Book Finder (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/README.md", "book_search_app/main.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && echo '✅ Packages installed'",
  "postAttachCommand": {
    "server": "python3 run.py --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": { "label": "Book Finder", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8000]
}
